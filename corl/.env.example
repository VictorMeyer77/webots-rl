# Webots Environment
WEBOTS_BIN_PATH=/Applications/Webots.app/Contents/MacOS/webots # Path to Webots binary executable
WEBOTS_EXPERIMENTS_DIR=projects/ # Root directory containing per-world experiment project folders

# Backend API
WEBOTS_API_HOST=http://localhost # Backend training server API host URL
WEBOTS_API_PORT=8000 # Backend training server API port number

# Console Logging
WEBOTS_LOG_CONSOLE_LEVEL=INFO # Console log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
WEBOTS_LOG_CONSOLE_HANDLER=true # Enable console logging handler

# File Logging
WEBOTS_LOG_FILE_LEVEL=INFO # File log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
WEBOTS_LOG_FILE_HANDLER=false # Enable file logging handler
WEBOTS_LOG_FILE_DIR=.log # Directory path for log files — use absolute path
WEBOTS_LOG_FILE_NAME=webots_rl # File name prefix for log files (without extension)
WEBOTS_LOG_FILE_MAX_BYTES=10485760 # Maximum size in bytes for a log file before rotation occurs
WEBOTS_LOG_FILE_BACKUP_COUNT=5 # Number of backup log files to keep when rotating

# Trainer
WEBOTS_TRAINER_OUTPUT_DIR=train/ # Root output directory for trainer artefacts (checkpoints, MLflow runs) — use absolute path
WEBOTS_TRAINER_WORKER_TIMEOUT=60 # Time in seconds to wait for a worker to respond before marking it as unresponsive

# Environment
WEBOTS_ENVIRONMENT_RECORD_FREQUENCY=50 # Interval in episodes at which worker 0 (witness) records an environment video during training
